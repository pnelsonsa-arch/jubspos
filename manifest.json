    </span><span class="yqj1Pc">workerPath</span><span class="undefined">: </span><span class="dk3nFb">'./worker.min.js'</span><span class="undefined">,
    </span><span class="yqj1Pc">corePath</span><span class="undefined">: </span><span class="dk3nFb">'./tesseract-core-simd.wasm.js'</span><span class="undefined">,
    </span><span class="yqj1Pc">langPath</span><span class="undefined">: </span><span class="dk3nFb">'./'</span><span class="undefined">, </span><span class="ojrtQ">// Looks for ./eng.traineddata.gz locally</span><span class="undefined">
    </span><span class="yqj1Pc">cacheMethod</span><span class="undefined">: </span><span class="dk3nFb">'none'</span><span class="undefined">
  });

  </span><span class="uiJ0Tc">const</span><span class="undefined"> { data: { </span><span class="yqj1Pc">text</span><span class="undefined"> } } = </span><span class="uiJ0Tc">await</span><span class="undefined"> worker.recognize(imageSource);
  </span><span class="uiJ0Tc">await</span><span class="undefined"> worker.terminate();
  </span><span class="uiJ0Tc">return</span><span class="undefined"> text;
}

</span><span class="ojrtQ">// 2. South African Retail Margin &amp; VAT (15%) Sell Price Calculator</span><span class="undefined">
</span><span class="ojrtQ">// Calculates retail shelf price in ZAR (R) from excl. or incl. supplier cost</span><span class="undefined">
</span><span class="uiJ0Tc">function</span><span class="undefined"> </span><span class="yqj1Pc">calculateSellPrice</span><span class="undefined">(</span><span class="yqj1Pc">costPrice</span><span class="undefined">, </span><span class="yqj1Pc">marginPercent</span><span class="undefined">, </span><span class="yqj1Pc">costIncludesVat</span><span class="undefined"> = </span><span class="uiJ0Tc">false</span><span class="undefined">) {
  </span><span class="uiJ0Tc">const</span><span class="undefined"> </span><span class="yqj1Pc">vatRate</span><span class="undefined"> = </span><span class="N1kUHb">1.15</span><span class="undefined">;
  </span><span class="uiJ0Tc">const</span><span class="undefined"> </span><span class="yqj1Pc">baseCost</span><span class="undefined"> = costIncludesVat ? costPrice / vatRate : costPrice;
  </span><span class="uiJ0Tc">const</span><span class="undefined"> </span><span class="yqj1Pc">sellExclVat</span><span class="undefined"> = baseCost * (</span><span class="N1kUHb">1</span><span class="undefined"> + marginPercent / </span><span class="N1kUHb">100</span><span class="undefined">);
  </span><span class="uiJ0Tc">const</span><span class="undefined"> </span><span class="yqj1Pc">sellInclVat</span><span class="undefined"> = sellExclVat * vatRate;
  </span><span class="uiJ0Tc">return</span><span class="undefined"> {
    </span><span class="yqj1Pc">sellExcl</span><span class="undefined">: Number(sellExclVat.toFixed(</span><span class="N1kUHb">2</span><span class="undefined">)),
    </span><span class="yqj1Pc">sellIncl</span><span class="undefined">: Number(sellInclVat.toFixed(</span><span class="N1kUHb">2</span><span class="undefined">)),
    </span><span class="yqj1Pc">profitRand</span><span class="undefined">: Number((sellExclVat - baseCost).toFixed(</span><span class="N1kUHb">2</span><span class="undefined">))
  };
}
